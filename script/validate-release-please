#!/usr/bin/env bash
set -euo pipefail

# Validate release-please-config.json:
# 1. Valid JSON
# 2. Referenced files exist
# 3. YAML extra-files have a parseable version field

CONFIG="release-please-config.json"
ERRORS=0

echo "=== Validating $CONFIG ==="

# 1. Valid JSON
echo "→ JSON syntax..."
if ! python3 -c "import json; json.load(open('$CONFIG'))"; then
  echo "  ❌ Invalid JSON"
  ERRORS=$((ERRORS + 1))
else
  echo "  Valid ✓"
fi

# 2. Check referenced files exist for each package
echo "→ Checking referenced files..."
for pkg_path in $(python3 -c "
import json
cfg = json.load(open('$CONFIG'))
for p in cfg.get('packages', {}):
    print(p)
"); do
  if [ ! -f "$pkg_path/version.txt" ]; then
    echo "  ❌ Missing: $pkg_path/version.txt (required by release-type: simple)"
    ERRORS=$((ERRORS + 1))
  fi

  for extra in $(python3 -c "
import json
cfg = json.load(open('$CONFIG'))
pkg = cfg['packages'].get('$pkg_path', {})
for f in pkg.get('extra-files', []):
    print(f if isinstance(f, str) else f.get('path', ''))
"); do
    if [ -n "$extra" ] && [ ! -f "$pkg_path/$extra" ]; then
      echo "  ❌ Missing: $pkg_path/$extra (listed in extra-files)"
      ERRORS=$((ERRORS + 1))
    fi
  done
done
echo "  Files exist ✓"

# 3. Check YAML extra-files have a version field at the expected jsonpath
echo "→ Checking version fields in YAML extra-files..."
python3 -c "
import json, yaml, sys

cfg = json.load(open('$CONFIG'))
errors = 0
for pkg_path, pkg_cfg in cfg.get('packages', {}).items():
    for f in pkg_cfg.get('extra-files', []):
        if isinstance(f, dict) and f.get('type') == 'yaml':
            path = f'{pkg_path}/{f[\"path\"]}'
            jsonpath = f.get('jsonpath', '')
            try:
                with open(path) as fh:
                    data = yaml.safe_load(fh)
                # simple \$.version check
                if jsonpath == '\$.version':
                    if 'version' not in data:
                        print(f'  ❌ {path} missing \"version\" key (jsonpath: {jsonpath})')
                        errors += 1
                    elif not data['version']:
                        print(f'  ❌ {path} has empty \"version\" value')
                        errors += 1
            except FileNotFoundError:
                pass  # already caught above
            except Exception as e:
                print(f'  ❌ {path} parse error: {e}')
                errors += 1
sys.exit(errors)
" || ERRORS=$((ERRORS + $?))
echo "  Version fields valid ✓"

echo ""
if [ "$ERRORS" -gt 0 ]; then
  echo "❌ $ERRORS error(s) found in release-please configuration"
  exit 1
fi

echo "✅ release-please configuration is valid"
