#!/usr/bin/env bash
set -euo pipefail

echo "==> Installing dependencies via Homebrew..."
brew bundle --file=Brewfile

echo "==> Ensuring Node.js is available..."
export PATH="$(brew --prefix node@26)/bin:$PATH"
echo "    Node $(node --version)"

echo "==> Installing the repository's npm version..."
npm install --global "npm@$(node -p "require('./package.json').devEngines.packageManager.version")"
echo "    npm $(npm --version)"

echo "==> Installing npm packages..."
npm ci

echo "==> Starting Ollama (if not already running)..."
if ! pgrep -x ollama &>/dev/null; then
  ollama serve &>/dev/null &
  sleep 2
fi

echo "==> Pulling eval model..."
ollama pull llama3.2:3b

echo ""
echo "✅ Setup complete! Run tests with:"
echo "   export PATH=\"$(brew --prefix node@26)/bin:\$PATH\""
echo "   npm test"
